{
  "name": "webcomponents",
  "version": "0.0.0",
  "description": "基于 Lit 的跨框架 Web Components UI 组件库",
  "author": "wuzheng001 <1962443189@qq.com>",
  "homepage": "https://github.com/Birdyqaq/silenceUI#readme",
  "license": "ISC",
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=22.17.1 <23",
    "pnpm": "8.15.9"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "unpkg": "dist/index.umd.cjs",
  "jsdelivr": "dist/index.umd.cjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Birdyqaq/silenceUI.git"
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "dev": "vite",
    "build": "vite build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint . --ext .ts,.js,.vue",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:dist": "tsc -p type-tests/tsconfig.json --noEmit",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p type-tests/tsconfig.json --noEmit && eslint . --ext .ts,.js,.vue && vitest --run && vite build && vitepress build docs",
    "format": "prettier --write \"**/*.{js,ts,vue,json,md}\""
  },
  "bugs": {
    "url": "https://github.com/Birdyqaq/silenceUI/issues"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@unocss/preset-icons": "^66.2.3",
    "@unocss/preset-uno": "^66.2.3",
    "@unocss/vite": "^66.2.3",
    "@vitest/ui": "^1.6.0",
    "empty-module": "^0.0.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jsdom": "^24.0.0",
    "node-stdlib-browser": "^1.3.1",
    "package-manager-detector": "^1.3.0",
    "prettier": "^3.2.5",
    "terser": "^5.43.0",
    "typescript": "^5.4.4",
    "unocss": "^66.2.3",
    "vite": "^4.5.0",
    "vite-plugin-dts": "^3.8.1",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vitepress": "^1.0.0",
    "vitest": "^1.6.1",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "lit": "^3.1.3"
  }
}
